#!/usr/bin/env bash
# Install (or re-install) this component into an avatar.
#
#   scripts/install <avatar-dir> [--dry-run] [--no-registry]
#
# For the whole fleet at once, do not loop over this by hand -- use
# nostr-relay/scripts/fleet-keys publish, which knows where every avatar lives and
# calls this for each of them.
#
# Re-runnable: it is also how an avatar picks up a fixed component, and how one
# carrying the old Go-container copy is upgraded.
set -euo pipefail

SRC="$(cd "$(dirname "$0")/.." && pwd)"
AV="${1:?usage: install <avatar-dir> [--dry-run] [--no-registry]}"; shift
DRY=0; NOREG=0
for a in "$@"; do
    case "$a" in
        --dry-run)     DRY=1 ;;
        --no-registry) NOREG=1 ;;   # the caller owns the address book (fleet-keys)
        *) echo "install: unknown option $a" >&2; exit 2 ;;
    esac
done
[[ -d "$AV/harness" ]] || { echo "install: no harness/ in $AV -- is this an avatar?" >&2; exit 1; }

run() { (( DRY )) && { echo "  $*"; return; }; "$@"; }

# The v1 container's files. An avatar that still has them would otherwise keep a
# compose file a harness folds into the agent's own stack -- the boot blocker this
# component was rebuilt to remove.
for stale in mailbox.compose.yml mailboxctl config Dockerfile go.mod go.sum cli \
             main.go mailbox.go store.go api.go relay.go identity.go config.go util.go; do
    [[ -e "$AV/tools/nostr-mailbox/$stale" ]] && run rm -rf "$AV/tools/nostr-mailbox/$stale"
done

run mkdir -p "$AV/tools/nostr-mailbox" "$AV/skills/mailbox"
run cp "$SRC/mailbox"                   "$AV/tools/nostr-mailbox/mailbox"
run cp "$SRC/skills/mailbox/SKILL.md"   "$AV/skills/mailbox/SKILL.md"

# The address book. Generated, per-avatar, and never clobbered once present -- its
# holder may extend it. Built from the PUBLIC halves in pass: every avatar that has
# been minted a key is addressable, and one that has not is not, which is the honest
# answer rather than a name nothing can be sent to.
REG="$AV/tools/nostr-mailbox/registry.json"
if (( NOREG )); then
    :
elif [[ -f "$REG" ]]; then
    echo "  registry.json present, left alone"
elif ! command -v pass >/dev/null; then
    echo "  NOTE: no registry.json and no pass here. Generate it where pass lives:"
    echo "        scripts/build-registry <avatar...> > $REG"
else
    : "${PASS_PREFIX:=nunet/avatars}"
    : "${PASSWORD_STORE_DIR:=$HOME/.password-store}"
    mapfile -t KEYED < <(
        for d in "$PASSWORD_STORE_DIR/$PASS_PREFIX"/*/; do
            [[ -f "$d/nostr-npub.gpg" ]] && basename "$d"
        done
    )
    if (( ${#KEYED[@]} == 0 )); then
        echo "  NOTE: no minted keys under pass:$PASS_PREFIX -- mint first (scripts/mint-avatar-keys)"
    elif (( DRY )); then
        echo "  would write registry.json covering: ${KEYED[*]}"
    else
        "$SRC/scripts/build-registry" "${KEYED[@]}" > "$REG"
        echo "  registry.json written, covering ${#KEYED[@]}: ${KEYED[*]}"
    fi
fi

# The symlink is resolved INSIDE the container, so it must point at the container
# path (/project/...), never at wherever this repo happens to sit on the host.
#
# It lands in harness/<h>/home/, which is GITIGNORED -- that tree is runtime state,
# like the skill symlinks the entrypoint regenerates on every start. So it is not
# committed and must not be: it survives rebuilds because the directory is real on
# the host, and a fresh clone gets it by running this script again.
for bin in "$AV"/harness/*/home/.local/bin; do
    [[ -d "$bin" ]] || continue
    run ln -sfn /project/tools/nostr-mailbox/mailbox "$bin/mailbox"
    echo "  linked $(basename "$(dirname "$(dirname "$(dirname "$bin")")")"):  mailbox"
done
# skills/ needs no link: register-skills symlinks it into each harness at boot.

grep -q 'NOSTR_MAILBOX_NSEC' "$AV/harness/config" 2>/dev/null \
    || echo "  TODO: add \"NOSTR_MAILBOX_NSEC=pass:nunet/avatars/<avatar>/nostr-nsec\" to SANDBOX_SECRETS in $AV/harness/config"
grep -q 'MAILBOX_API_TOKEN' "$AV/harness/config" 2>/dev/null \
    && echo "  TODO: remove MAILBOX_API_TOKEN from $AV/harness/config -- it guards nothing now"

cat <<EOF

install: done$( (( DRY )) && echo ' (dry run)'). In the avatar:

    git add tools/nostr-mailbox skills/mailbox && git commit

  Those two are all that is tracked. The CLI symlink is NOT committed -- it lives in
  the gitignored harness home, like the skill links, and re-running this script is
  how it comes back.

  Then rebuild, and run \`mailbox doctor\` inside the avatar.
EOF
